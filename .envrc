# direnv (https://direnv.net/): activates .venv and loads .env when you cd into the repo.
#   brew install direnv
#   eval "$(direnv hook zsh)"   # in ~/.zshrc (or bash equivalent)
#   direnv allow                # once, in this directory
# Optional: `just` already loads .env into its recipes and sets the paths below itself.

export VIRTUAL_ENV_DISABLE_PROMPT=1

if [ -d .venv ]; then
    export VIRTUAL_ENV="$(pwd)/.venv"
    export PATH="$VIRTUAL_ENV/bin:$PATH"
fi

if [ -f .env ]; then
    dotenv .env
fi

# Same local-state layout as the justfile.
export DAGSTER_HOME="$(pwd)/.dagster"
export DLT_PROJECT_DIR="$(pwd)"
export DLT_DATA_DIR="$(pwd)/.dlt/data"
export DBT_PROFILES_DIR="$(pwd)/dbt"
export PYTHONWARNINGS="ignore:::snowflake.connector.vendored.requests"
