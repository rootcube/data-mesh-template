# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.iml
*.swp

# --- Secrets / env ---
.env
.env.*
!.env.example
*.p8
*.pem
*.key
*.pub

# --- Python / uv ---
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# --- Dagster local instance (config file is versioned, state is not) ---
.dagster/*
!.dagster/dagster.yaml
.local_defs_state/
.run/

# --- dlt (config is versioned, secrets and working data are not) ---
.dlt/*
!.dlt/config.toml

# --- dbt ---
dbt/*/target/
dbt/*/packages/
dbt/*/dbt_packages/
dbt/*/logs/
dbt/*/package-lock.concurrent-update-lock
dbt/.user.yml
logs/

# --- Terraform ---
terraform/.terraform/
terraform/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
*.tfplan
crash.log
*_override.tf
*_override.tf.json

# --- MkDocs ---
site/

# --- Claude Code ---
.claude/
