{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "organisation.schema.json",
  "title": "Organisation Configuration",
  "description": "The highest-level trust boundary for the platform. Typically corresponds to a legal, regulatory, or financial entity.",
  "type": "object",
  "required": ["code", "name"],
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string",
      "description": "Short code for the organisation (uppercase)",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "minLength": 2,
      "maxLength": 10
    },
    "name": {
      "type": "string",
      "description": "Human-readable name of the organisation",
      "minLength": 1,
      "maxLength": 100
    },
    "desc": {
      "type": "string",
      "description": "Description of the organisation",
      "maxLength": 500
    },
    "alias": {
      "type": "string",
      "description": "Alternative name or abbreviation for the organisation",
      "maxLength": 50
    }
  }
}
