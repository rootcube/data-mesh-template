{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "layer.schema.json",
  "title": "Layer Configuration",
  "description": "Logical and semantic structure for organizing data within a Project and Environment.",
  "type": "object",
  "required": ["code", "name", "type"],
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string",
      "description": "Short code for the layer (3 lowercase letters)",
      "pattern": "^[a-z]{3}$"
    },
    "name": {
      "type": "string",
      "description": "Human-readable name of the layer",
      "minLength": 1,
      "maxLength": 100
    },
    "desc": {
      "type": "string",
      "description": "Description of the layer's purpose",
      "maxLength": 500
    },
    "type": {
      "type": "string",
      "description": "Category of the layer",
      "enum": ["input", "processing", "output", "operational"]
    },
    "sort": {
      "type": "integer",
      "description": "Sort order for display purposes",
      "minimum": 0
    },
    "alias": {
      "type": "string",
      "description": "Alternative name or abbreviation for the layer",
      "maxLength": 50
    },
    "disabled": {
      "type": "boolean",
      "description": "Whether this layer is disabled and unavailable for use",
      "default": false
    },
    "required": {
      "type": "boolean",
      "description": "Whether this layer must be created for every project",
      "default": false
    }
  }
}
