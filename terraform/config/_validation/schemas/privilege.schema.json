{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "privilege.schema.json",
  "title": "Snowflake Privilege Bundles Configuration",
  "description": "Defines reusable privilege bundles that group related Snowflake grants into logical units for role assignments.",
  "type": "object",
  "required": ["snowflake"],
  "additionalProperties": false,
  "properties": {
    "snowflake": {
      "type": "object",
      "description": "Map of privilege bundle names to their privilege definitions",
      "additionalProperties": {
        "$ref": "#/$defs/privilegeBundle"
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "description": "Bundle names must be lowercase alphanumeric with underscores"
      }
    }
  },
  "$defs": {
    "privilegeBundle": {
      "type": "object",
      "description": "A bundle of privileges grouped by object type",
      "additionalProperties": false,
      "properties": {
        "account": {
          "$ref": "#/$defs/accountPrivileges"
        },
        "warehouse": {
          "$ref": "#/$defs/warehousePrivileges"
        },
        "database": {
          "$ref": "#/$defs/databasePrivileges"
        },
        "schema": {
          "$ref": "#/$defs/schemaPrivileges"
        },
        "user": {
          "$ref": "#/$defs/userPrivileges"
        },
        "role": {
          "$ref": "#/$defs/rolePrivileges"
        },
        "tables": {
          "$ref": "#/$defs/tablePrivileges"
        },
        "dynamic_tables": {
          "$ref": "#/$defs/dynamicTablePrivileges"
        },
        "hybrid_tables": {
          "$ref": "#/$defs/hybridTablePrivileges"
        },
        "iceberg_tables": {
          "$ref": "#/$defs/icebergTablePrivileges"
        },
        "external_tables": {
          "$ref": "#/$defs/externalTablePrivileges"
        },
        "event_tables": {
          "$ref": "#/$defs/eventTablePrivileges"
        },
        "views": {
          "$ref": "#/$defs/viewPrivileges"
        },
        "materialized_views": {
          "$ref": "#/$defs/materializedViewPrivileges"
        },
        "functions": {
          "$ref": "#/$defs/functionPrivileges"
        },
        "procedures": {
          "$ref": "#/$defs/procedurePrivileges"
        },
        "streams": {
          "$ref": "#/$defs/streamPrivileges"
        },
        "stages": {
          "$ref": "#/$defs/stagePrivileges"
        },
        "file_formats": {
          "$ref": "#/$defs/fileFormatPrivileges"
        },
        "sequences": {
          "$ref": "#/$defs/sequencePrivileges"
        },
        "secrets": {
          "$ref": "#/$defs/secretPrivileges"
        },
        "tags": {
          "$ref": "#/$defs/tagPrivileges"
        },
        "tasks": {
          "$ref": "#/$defs/taskPrivileges"
        },
        "pipes": {
          "$ref": "#/$defs/pipePrivileges"
        },
        "alerts": {
          "$ref": "#/$defs/alertPrivileges"
        },
        "network_rules": {
          "$ref": "#/$defs/networkRulePrivileges"
        },
        "integrations": {
          "$ref": "#/$defs/integrationPrivileges"
        },
        "connections": {
          "$ref": "#/$defs/connectionPrivileges"
        },
        "notebooks": {
          "$ref": "#/$defs/notebookPrivileges"
        },
        "services": {
          "$ref": "#/$defs/servicePrivileges"
        },
        "compute_pools": {
          "$ref": "#/$defs/computePoolPrivileges"
        },
        "image_repositories": {
          "$ref": "#/$defs/imageRepositoryPrivileges"
        },
        "models": {
          "$ref": "#/$defs/modelPrivileges"
        },
        "git_repositories": {
          "$ref": "#/$defs/gitRepositoryPrivileges"
        },
        "masking_policies": {
          "$ref": "#/$defs/maskingPolicyPrivileges"
        },
        "row_access_policies": {
          "$ref": "#/$defs/rowAccessPolicyPrivileges"
        },
        "password_policies": {
          "$ref": "#/$defs/passwordPolicyPrivileges"
        },
        "session_policies": {
          "$ref": "#/$defs/sessionPolicyPrivileges"
        },
        "aggregation_policies": {
          "$ref": "#/$defs/aggregationPolicyPrivileges"
        },
        "projection_policies": {
          "$ref": "#/$defs/projectionPolicyPrivileges"
        },
        "authentication_policies": {
          "$ref": "#/$defs/authenticationPolicyPrivileges"
        },
        "packages_policies": {
          "$ref": "#/$defs/packagesPolicyPrivileges"
        },
        "data_metric_functions": {
          "$ref": "#/$defs/dataMetricFunctionPrivileges"
        }
      }
    },
    "accountPrivileges": {
      "type": "array",
      "description": "Account-level privileges",
      "items": {
        "type": "string",
        "enum": [
          "APPLY MASKING POLICY",
          "APPLY PASSWORD POLICY",
          "APPLY ROW ACCESS POLICY",
          "APPLY SESSION POLICY",
          "APPLY AUTHENTICATION POLICY",
          "APPLY PACKAGES POLICY",
          "APPLY AGGREGATION POLICY",
          "APPLY PROJECTION POLICY",
          "APPLY TAG",
          "ATTACH POLICY",
          "AUDIT",
          "BIND SERVICE ENDPOINT",
          "CREATE ACCOUNT",
          "CREATE APPLICATION",
          "CREATE APPLICATION PACKAGE",
          "CREATE COMPUTE POOL",
          "CREATE CONNECTION",
          "CREATE DATA EXCHANGE LISTING",
          "CREATE DATABASE",
          "CREATE EXTERNAL VOLUME",
          "CREATE FAILOVER GROUP",
          "CREATE INTEGRATION",
          "CREATE NETWORK POLICY",
          "CREATE REPLICATION GROUP",
          "CREATE ROLE",
          "CREATE SHARE",
          "CREATE USER",
          "CREATE WAREHOUSE",
          "EXECUTE ALERT",
          "EXECUTE DATA METRIC FUNCTION",
          "EXECUTE MANAGED ALERT",
          "EXECUTE MANAGED TASK",
          "EXECUTE TASK",
          "IMPORT SHARE",
          "MANAGE ACCOUNT SUPPORT CASES",
          "MANAGE GRANTS",
          "MANAGE USER SUPPORT CASES",
          "MANAGE WAREHOUSES",
          "MODIFY LOG LEVEL",
          "MODIFY METRIC LEVEL",
          "MODIFY SESSION LOG LEVEL",
          "MODIFY SESSION METRIC LEVEL",
          "MODIFY SESSION TRACE LEVEL",
          "MODIFY TRACE LEVEL",
          "MONITOR",
          "MONITOR EXECUTION",
          "MONITOR SECURITY",
          "MONITOR USAGE",
          "OVERRIDE SHARE RESTRICTIONS",
          "PURCHASE DATA EXCHANGE LISTING",
          "RESOLVE ALL",
          "READ SESSION"
        ]
      },
      "uniqueItems": true
    },
    "warehousePrivileges": {
      "type": "array",
      "description": "Warehouse privileges",
      "items": {
        "type": "string",
        "enum": [
          "APPLYBUDGET",
          "MODIFY",
          "MONITOR",
          "OPERATE",
          "USAGE"
        ]
      },
      "uniqueItems": true
    },
