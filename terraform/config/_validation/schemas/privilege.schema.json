          "CREATE EXTERNAL TABLE",
          "CREATE FILE FORMAT",
          "CREATE FUNCTION",
          "CREATE GIT REPOSITORY",
          "CREATE HYBRID TABLE",
          "CREATE ICEBERG TABLE",
          "CREATE IMAGE REPOSITORY",
          "CREATE MASKING POLICY",
          "CREATE MATERIALIZED VIEW",
          "CREATE MODEL",
          "CREATE NETWORK RULE",
          "CREATE NOTEBOOK",
          "CREATE PACKAGES POLICY",
          "CREATE PASSWORD POLICY",
          "CREATE PIPE",
          "CREATE PROCEDURE",
          "CREATE PROJECTION POLICY",
          "CREATE ROW ACCESS POLICY",
          "CREATE SECRET",
          "CREATE SEQUENCE",
          "CREATE SERVICE",
          "CREATE SESSION POLICY",
          "CREATE SNAPSHOT",
          "CREATE STAGE",
          "CREATE STREAM",
          "CREATE STREAMLIT",
          "CREATE TABLE",
          "CREATE TAG",
          "CREATE TASK",
          "CREATE VIEW",
          "CREATE SNOWFLAKE.CORE.BUDGET",
          "CREATE SNOWFLAKE.ML.ANOMALY_DETECTION",
          "CREATE SNOWFLAKE.ML.CLASSIFICATION",
          "CREATE SNOWFLAKE.ML.FORECAST",
          "CREATE SNOWFLAKE.ML.TOP_INSIGHTS",
          "MODIFY",
          "MONITOR",
          "USAGE"
        ]
      },
      "uniqueItems": true
    },
    "userPrivileges": {
      "type": "array",
      "description": "User object privileges",
      "items": {
        "type": "string",
        "enum": [
          "IMPERSONATE",
          "MONITOR",
          "MODIFY PROGRAMMATIC AUTHENTICATION METHODS"
        ]
      },
      "uniqueItems": true
    },
    "rolePrivileges": {
      "type": "array",
      "description": "Role object privileges",
      "items": {
        "type": "string",
        "enum": [
          "USAGE"
        ]
      },
      "uniqueItems": true
    },
    "tablePrivileges": {
      "type": "array",
      "description": "Table privileges",
      "items": {
        "type": "string",
        "enum": [
          "APPLYBUDGET",
          "DELETE",
          "EVOLVE SCHEMA",
          "INSERT",
          "REFERENCES",
          "SELECT",
          "TRUNCATE",
          "UPDATE"
