    "stagePrivileges": {
      "type": "array",
      "description": "Stage privileges",
      "items": {
        "type": "string",
        "enum": [
          "READ",
          "WRITE"
        ]
      },
      "uniqueItems": true
    },
    "fileFormatPrivileges": {
      "type": "array",
