{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "compute.schema.json",
  "title": "Compute Configuration",
  "description": "Standardized execution resource abstractions for sizing, scaling, and isolating compute.",
  "type": "object",
  "required": ["code", "name"],
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string",
      "description": "Short code for the compute profile (empty string for default)",
      "pattern": "^[a-z]{0,3}$"
    },
    "name": {
      "type": "string",
      "description": "Human-readable name of the compute profile",
      "minLength": 1,
      "maxLength": 50
    },
    "desc": {
      "type": "string",
      "description": "Description of the compute profile's purpose",
      "maxLength": 500
    },
    "alias": {
      "type": "string",
      "description": "Alternative name or abbreviation for the compute profile",
      "maxLength": 50
    },
    "disabled": {
      "type": "boolean",
      "description": "Whether this compute profile is disabled and unavailable for use",
      "default": false
    },
    "required": {
      "type": "boolean",
      "description": "Whether this compute profile must be created for every project",
      "default": false
    },
    "sizes": {
      "type": "array",
      "description": "Available warehouse sizes for this compute profile",
      "items": {
        "type": "string",
        "enum": ["xs", "s", "m", "l", "xl", "xxl", "xxxl", "x4l", "x5l", "x6l"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "auto_suspend": {
      "type": "integer",
      "description": "Seconds of inactivity before auto-suspend",
      "minimum": 0,
      "maximum": 3600,
      "default": 60
    },
    "auto_resume": {
      "type": "boolean",
      "description": "Whether to auto-resume on query",
      "default": true
    },
    "min_cluster_count": {
      "type": "integer",
      "description": "Minimum number of clusters",
      "minimum": 1,
      "maximum": 10,
      "default": 1
    },
    "max_cluster_count": {
      "type": "integer",
      "description": "Maximum number of clusters",
      "minimum": 1,
      "maximum": 10,
      "default": 1
    }
  }
}
