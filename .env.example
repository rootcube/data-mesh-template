# Personal settings for local development. `just snowflake setup` fills in the Snowflake block
# after a one-time interactive login; edit by hand only to change defaults.
#
# Do not quote values: python-dotenv strips quotes, but `just` (dotenv-load) and Docker pass
# them literally, which breaks identifiers and file paths.

# Environment this checkout runs as: dev (personal schemas) or prd (shared layer schemas)
ENVIRONMENT=dev

# Account identifier as <organization>-<account>, e.g. MYORG-MYACCOUNT (a trial account works)
SNOWFLAKE_ACCOUNT=
# Your Snowflake login (exact, as CURRENT_USER() returns it)
SNOWFLAKE_USER=
# Private key written by `just snowflake setup` (absolute path) and its optional passphrase
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Your engineer role, the development database and the warehouse of the project you work in
# (provisioned by Terraform from terraform/config, see terraform/README.md)
SNOWFLAKE_ROLE=RL_EXAMPLE_DEV__ENG
SNOWFLAKE_WAREHOUSE=WH_EXAMPLE_DEV
SNOWFLAKE_DATABASE=DB_EXAMPLE_DEV
# Prefix of your personal schemas in dev: <prefix>_SRC, <prefix>_STG, ... (DBT_<USERNAME>)
SNOWFLAKE_SCHEMA=DBT_<USERNAME>

# dbt target override: leave unset to follow ENVIRONMENT; dummy = in-memory DuckDB, never Snowflake
# DBT_TARGET=dummy

# dlt logging for local runs: INFO for step-level logs, DEBUG for everything
RUNTIME__LOG_LEVEL=INFO

# --- Platform administrators: Terraform provisioning user (key pair, see terraform/README.md) --
# TF_VAR_SNOWFLAKE_ORGANIZATION=MYORG
# TF_VAR_SNOWFLAKE_ACCOUNT=MYACCOUNT
# TF_VAR_SNOWFLAKE_USER=TERRAFORM_USER
# TF_VAR_SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/keys/terraform.p8
# TF_VAR_SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
